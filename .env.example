# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/rxcompare

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Public URL of the app (used to build email verification links)
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Hardcoded administrator (no database registration for admins)
# Admin portal is only reachable at /admin-login
# ---------------------------------------------------------------------------
ADMIN_NAME=Dr. Rajesh Varma
ADMIN_EMAIL=admin@rxcompare.gov.in
ADMIN_PASSWORD=Admin@12345
ADMIN_DESIGNATION=Chief PMBJP Network Administrator

# ---------------------------------------------------------------------------
# Email (Nodemailer) — real OTP verification mail
# SMTP_USER is the sender mailbox (e.g. youraddress@gmail.com) and SMTP_PASS is
# its app password / SMTP password. Leave SMTP_* blank in development to use an
# automatic Ethereal test inbox (a preview URL is printed to the server console).
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Jan Aushadhi RxCompare <no-reply@rxcompare.gov.in>"

# ---------------------------------------------------------------------------
# Optional ABDM / UHI gateway
# ---------------------------------------------------------------------------
UHI_AUTH_TOKEN=
UHI_CONSUMER_ID=
UHI_GATEWAY_URL=
VITE_API_URL=
